NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (Supabase > Settings > API). Usada só no servidor, pelo
# despachante de lembretes, que precisa ler consultas de todos os psicólogos
# (não existe usuário logado no contexto do cron). Nunca prefixar com
# NEXT_PUBLIC_: ela dá acesso irrestrito ao banco, ignorando RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Chave da API do Google Gemini (https://aistudio.google.com/apikey) — usada
# só no servidor (src/app/api/gemini/route.ts), nunca prefixar com NEXT_PUBLIC_.
GEMINI_API_KEY=

# --- Lembretes de consulta (1h antes) -------------------------------------

# Segredo que o pg_cron usa para chamar /api/notificacoes/dispatch. Precisa
# ser o MESMO valor gravado em app_secrets.cron_secret no banco (ver o final
# do schema.sql). Gere algo longo e aleatório.
CRON_SECRET=

# Envio de e-mail (https://resend.com — plano grátis: 3 mil e-mails/mês).
# Sem estas duas, o sistema não enfileira lembretes por e-mail.
RESEND_API_KEY=
RESEND_FROM="Psi Rob <lembretes@seudominio.com>"

# Opcional: recebe um POST com os dados do lembrete (Zapier, n8n, Make...),
# para disparar WhatsApp/SMS ou o que mais quiser. Sem a URL, o canal fica
# desligado. O secret assina o corpo em X-Psirob-Signature (HMAC-SHA256).
NOTIFICACOES_WEBHOOK_URL=
NOTIFICACOES_WEBHOOK_SECRET=
