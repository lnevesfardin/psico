NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (Supabase > Settings > API). Usada só no servidor, pelo
# despachante de lembretes, que precisa ler consultas de todos os psicólogos
# (não existe usuário logado no contexto do cron). Nunca prefixar com
# NEXT_PUBLIC_: ela dá acesso irrestrito ao banco, ignorando RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Chave da API do Google Gemini (https://aistudio.google.com/apikey) — usada
# só no servidor (src/app/api/gemini/route.ts), nunca prefixar com NEXT_PUBLIC_.
GEMINI_API_KEY=

# --- Lembretes de consulta (1h antes) -------------------------------------

# Segredo que o pg_cron usa para chamar /api/notificacoes/dispatch. Precisa
# ser o MESMO valor gravado em app_secrets.cron_secret no banco (ver o final
# do schema.sql). Gere algo longo e aleatório.
CRON_SECRET=

# Envio de e-mail via Brevo (https://brevo.com — plano grátis: 300/dia).
# Escolhida no lugar do Resend por aceitar remetente verificado por endereço
# avulso, sem exigir domínio próprio. BREVO_FROM_EMAIL precisa ser um
# remetente já confirmado no painel da Brevo (Senders & IPs).
# Sem estas duas, o sistema não enfileira lembretes por e-mail.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME="Psico"

# Opcional: recebe um POST com os dados do lembrete (Zapier, n8n, Make...),
# para disparar WhatsApp/SMS ou o que mais quiser. Sem a URL, o canal fica
# desligado. O secret assina o corpo em X-Psico-Signature (HMAC-SHA256).
NOTIFICACOES_WEBHOOK_URL=
NOTIFICACOES_WEBHOOK_SECRET=

# --- Assinatura (Stripe) ----------------------------------------------------

# Chave secreta da API (https://dashboard.stripe.com/apikeys) — nunca
# prefixar com NEXT_PUBLIC_. Use a de teste (sk_test_...) até estar pronto
# pra cobrar de verdade.
STRIPE_SECRET_KEY=

# Segredo do endpoint de webhook (Developers > Webhooks > seu endpoint >
# Signing secret) — confirma que o evento recebido em /api/stripe/webhook
# veio mesmo do Stripe, não de qualquer POST forjado.
STRIPE_WEBHOOK_SECRET=

# IDs dos preços (Product catalog no painel do Stripe), um por plano:
# Mensal = R$ 59,00 recorrente mensal. Anual = R$ 588,00 recorrente anual
# (equivalente a R$ 49/mês — 17% mais barato que pagar mês a mês).
STRIPE_PRICE_MENSAL=
STRIPE_PRICE_ANUAL=
